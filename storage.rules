rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read and write access to all files for this demo app.
    // This rule allows unauthenticated users to upload files.
    // In a real app, you would secure this based on your user authentication.
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
